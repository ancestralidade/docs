+param([Parameter(Mandatory=$true)][string]$SourceAttachment,[string]$AppRoot='C:/Github/Ancestralidade/app')
+# KF06-06: verificação documental/local; sem commits, push, dependências ou implementação.
+$ErrorActionPreference='Stop'
+if($PSScriptRoot){$root=Split-Path -Parent $PSScriptRoot}else{$root=(Get-Location).Path}
+$ref='dad48511595f1d0fa3d06590da222cc0fabaef0a';$blob='22ce8ac5087cfb1c633f3b266f35776965c09733'
+$output='validation/evidence/app-bootstrap-validation.json';$docsDiff='validation/evidence/app-bootstrap-docs.diff';$appDiff='validation/evidence/app-bootstrap-app.diff'
+$encoding=New-Object Text.UTF8Encoding($false)
+function Read-Doc([string]$p){[IO.File]::ReadAllText((Join-Path $root $p))}
+function Git-Read([string]$Folder,[string[]]$Arguments){$p=New-Object Diagnostics.ProcessStartInfo;$p.FileName='git';$p.WorkingDirectory=$Folder;$p.Arguments=(@($Arguments|ForEach-Object{'"'+$_.Replace('"','\"')+'"'}) -join ' ');$p.UseShellExecute=$false;$p.RedirectStandardOutput=$true;$p.RedirectStandardError=$true;$p.StandardOutputEncoding=$encoding;$proc=[Diagnostics.Process]::Start($p);$out=$proc.StandardOutput.ReadToEnd();$err=$proc.StandardError.ReadToEnd();$proc.WaitForExit();[pscustomobject]@{exit_code=$proc.ExitCode;stdout=$out;stderr=$err}}
+function Git-Value([string]$Folder,[string[]]$Arguments){$v=Git-Read $Folder $Arguments;if($v.exit_code){throw ('Falha de leitura Git: '+$v.stderr)};$v.stdout.TrimEnd("`r","`n")}
+function Lines([string]$t){@($t -split '\r?\n'|Where-Object{$_})}
+function Body([string]$t){[regex]::Replace($t,'(?s)\A---\r?\n.*?\r?\n---\r?\n\r?\n','')}
+$issues=New-Object 'Collections.Generic.List[string]'
+$baseline=(Read-Doc 'validation/evidence/app-bootstrap-baseline.json')|ConvertFrom-Json
+$inspection=(Read-Doc 'validation/evidence/app-bootstrap-repository-inspection.json')|ConvertFrom-Json
+$private=(Read-Doc 'validation/evidence/app-bootstrap-private-verification.json')|ConvertFrom-Json
+$modifiedAllowed=@('AGENTS.md','README.md','architecture/ARCHITECTURE-BASELINE.md','context/PROJECT-CONTEXT.md','decisions/DECISION-REGISTER.md','engineering/APP-BOOTSTRAP-SPECIFICATION.md','engineering/REQUIREMENT-REGISTER.md','governance/AUTHORITY-MODEL.md','governance/PROJECT-INSTRUCTIONS.md','governance/RAG-PROTOCOL.md','governance/SOURCE-MANIFEST.md','governance/SOURCE-RECONCILIATION.md','planning/M01-ROADMAP.md','planning/WORK-PACKAGE-REGISTER.md','product/M01-FUNCTIONAL-REQUIREMENTS.md','product/M01-PRODUCT-BASELINE.md','status/CURRENT-STATUS.md','status/NORMATIVE-CONFLICT-REGISTER.md','status/RISK-REGISTER.md','validation/KNOWLEDGE-READINESS.md','validation/M01-ACCEPTANCE-CRITERIA.md','validation/M01-NORMATIVE-TRACEABILITY.md')
+$newAllowed=@('governance/sources/kf-final-acceptance-and-app-bootstrap-01.md','governance/reviews/cto-kf-final-acceptance-01.md','validation/AC-KF-ACCEPTED-01.md','engineering/REQ-APP-BOOTSTRAP-01.md','engineering/IMP-APP-BOOTSTRAP-01.md','validation/VAL-APP-BOOTSTRAP-01.md','status/APP-BOOTSTRAP-HANDOFF.md','validation/validate-app-bootstrap.ps1','validation/evidence/app-bootstrap-baseline.json','validation/evidence/app-bootstrap-repository-inspection.json','validation/evidence/app-bootstrap-private-verification.json','validation/evidence/app-bootstrap-validation.json','validation/evidence/app-bootstrap-docs.diff','validation/evidence/app-bootstrap-app.diff')
+$appAllowed=@('.gitignore','AGENTS.md','README.md','governance/NORMATIVE-TRACEABILITY.json','status/INITIAL-STATE.md')
+$head=Git-Value $root @('rev-parse','HEAD');$branch=Git-Value $root @('branch','--show-current')
+if($head -ne $ref -or $branch -ne 'dev' -or $baseline.files.Count -ne 105 -or $baseline.initial_working_tree -ne 'CLEAN'){$issues.Add('Baseline docs não corresponde ao checkpoint aceito/árvore limpa')}
