+# Valida a emenda de visibilidade; somente leitura Git e escrita de novas evidências/patches.
+param([string]$AppRoot='C:/Github/Ancestralidade/app')
+$ErrorActionPreference='Stop'
+if($PSScriptRoot){$root=Split-Path -Parent $PSScriptRoot}else{$root=(Get-Location).Path}
+$encoding=New-Object Text.UTF8Encoding($false)
+function Read-Doc([string]$Path){[IO.File]::ReadAllText((Join-Path $root $Path))}
+function Git-Read([string]$Folder,[string[]]$Arguments){$p=New-Object Diagnostics.ProcessStartInfo;$p.FileName='git';$p.WorkingDirectory=$Folder;$p.Arguments=(@($Arguments|ForEach-Object{'"'+$_.Replace('"','\"')+'"'}) -join ' ');$p.UseShellExecute=$false;$p.RedirectStandardOutput=$true;$p.RedirectStandardError=$true;$p.StandardOutputEncoding=$encoding;$process=[Diagnostics.Process]::Start($p);$out=$process.StandardOutput.ReadToEnd();$err=$process.StandardError.ReadToEnd();$process.WaitForExit();[pscustomobject]@{exit_code=$process.ExitCode;stdout=$out;stderr=$err}}
+function Git-Value([string]$Folder,[string[]]$Arguments){$r=Git-Read $Folder $Arguments;if($r.exit_code){throw ('Git read failed: '+$Arguments[0])};$r.stdout.TrimEnd("`r","`n")}
