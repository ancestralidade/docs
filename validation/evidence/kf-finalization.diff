+ $p=New-Object Diagnostics.ProcessStartInfo;$p.FileName='git';$p.WorkingDirectory=$root;$p.Arguments=(@($Arguments|ForEach-Object{'"'+$_.Replace('"','\"')+'"'}) -join ' ');$p.UseShellExecute=$false;$p.RedirectStandardOutput=$true;$p.RedirectStandardError=$true;$p.StandardOutputEncoding=$encoding;$p.StandardErrorEncoding=$encoding
