{
  "name": "ancestralidade-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "docs:check": "node .vitepress/check.mjs",
    "docs:build": "npm run docs:check && vitepress build .",
    "docs:login": "npx --yes vercel@68.0.0 login",
    "docs:link": "npx --yes vercel@68.0.0 link",
    "docs:deploy": "npx --yes vercel@68.0.0 deploy --target=preview",
    "docs:inspect": "npx --yes vercel@68.0.0 inspect"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vue": "3.5.46"
  },
  "overrides": {
    "vite": "6.4.6"
  }
}
